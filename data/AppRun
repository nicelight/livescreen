#!/usr/bin/env bash
set -euo pipefail
app_dir="$(dirname "$(readlink -f "$0")")"
export GST_PLUGIN_PATH="${app_dir}/usr/lib/gstreamer-1.0:${GST_PLUGIN_PATH:-}"
export XDG_DATA_DIRS="${app_dir}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
if [[ -x "${app_dir}/usr/libexec/gstreamer-1.0/gst-plugin-scanner" ]]; then
    export GST_PLUGIN_SCANNER="${app_dir}/usr/libexec/gstreamer-1.0/gst-plugin-scanner"
fi
exec "${app_dir}/usr/bin/livescreen" "$@"
